NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
RESEND_API_KEY=your-resend-api-key

# Secret bearer token protecting the scheduled compliance-reminder cron
# (/api/cron/compliance-reminders). Set the same value in Vercel; Vercel Cron
# sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=your-random-cron-secret

# Optional — CAPTCHA on login/register/forgot-password. Free at
# dash.cloudflare.com/?to=/:account/turnstile. This is the SITE key only —
# the secret key doesn't go here, it goes into Supabase Dashboard >
# Authentication > Settings > Attack Protection > Enable Captcha protection
# (Turnstile). Supabase verifies the token server-side using that secret;
# our code just renders the widget and forwards the token it produces.
# Leaving this unset disables the widget entirely; nothing else changes.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional — durable (cross-instance) rate limiting. Free at upstash.com.
# Falls back to the existing in-memory limiter when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — error monitoring. Free at sentry.io. No-op when unset.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, only needed for source-mapped stack traces in Sentry (not
# required for error monitoring to work at all).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — lets /system-info pull its Build Timeline live from GitHub
# instead of a hand-maintained list. Fine-grained PAT scoped to this repo
# only, Contents: Read-only. github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional — file uploads (certification/complaint attachments, barangay
# reports) go to Cloudinary instead of Supabase Storage when set, and
# /lgu/settings/storage shows usage stats + a file browser. Free at
# cloudinary.com — all three values are on the Dashboard home page.
# Existing Supabase-stored files/URLs are untouched either way.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
